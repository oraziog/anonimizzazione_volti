# ── Server ────────────────────────────────────────────────────────────────────
BIND_ADDR=0.0.0.0:8080
# Max accepted upload body size in bytes for /anonymize (spec: min 3.5 GiB).
# /anonymize/batch has no body limit (archives are spooled to disk).
BODY_LIMIT_BYTES=3758096384
# Per-image inference concurrency. When unset it is auto-detected:
# cores ≤ 4 → all cores; cores > 4 → cores − 2. Override only to tune.
#MAX_CONCURRENT_IMAGES=8
# JPEG re-encode quality for processed JPEG outputs (PNG outputs are lossless)
JPEG_QUALITY=95

# ── Models (downloaded at runtime, spec §3) ──────────────────────────────────
# Public yolov8n-face ONNX (5 keypoints, output [1,15,8400]) used as a working
# default for testing. Override with your own export for production.
YOLO_MODEL_URL=https://github.com/yakhyo/yolov8-face-onnx-inference/releases/download/weights/yolov8n-face.onnx
# Optional: initial classifier. Until the first nightly retrain succeeds
# (or this is set), ACTIVE cameras blur every in-ROI detection (fail-safe).
CLASSIFIER_MODEL_URL=
MODEL_CACHE_DIR=/app/models/cache/
# Optional SHA-256 integrity checks (hex). Empty = skip verification.
MODEL_YOLO_SHA256=33f3951af7fc0c4d9b321b29cdcd8c9a59d0a29a8d4bdc01fcb5507d5c714809
MODEL_CLASSIFIER_SHA256=

# ── Storage ──────────────────────────────────────────────────────────────────
DATA_DIR=/app/data/
DATASET_FP_DIR=/app/dataset_falsi_positivi/
DATASET_SEED_REAL_FACES_DIR=/app/dataset_seed/real_faces/
MODELS_BACKUP_DIR=/app/models/backup/

# Retention of the anonymized outputs (<input>_elaborato.zip) accumulated in
# DATA_DIR. A background loop prunes them by age and/or total size. Set
# RETENTION_ENABLED=false (or both thresholds to 0) to disable entirely.
RETENTION_ENABLED=true
# Delete outputs older than this many days (0 = rule off)
RETENTION_MAX_DAYS=30
# When the total size of outputs exceeds this (GB), delete the oldest
# eligible ones first until back under the threshold (0 = rule off)
RETENTION_MAX_GB=20.0
# How often the cleanup pass runs (seconds)
RETENTION_INTERVAL_SECS=3600
# Outputs modified more recently than this are never deleted (seconds) —
# protects outputs mid-write or currently streaming back to a client
RETENTION_MIN_AGE_SECS=1800

# ── Pipeline thresholds ──────────────────────────────────────────────────────
YOLO_CONF_THRESHOLD=0.20
YOLO_NMS_IOU=0.45
# Detections with confidence in [threshold, FP_CROP_CONF_MAX) are saved as
# false-positive candidates for retraining
FP_CROP_CONF_MAX=0.50
# Full-image blur sigma for the INITIAL fallback state
INITIAL_BLUR_SIGMA=20.0
# Extra dilation of the keypoint convex hull in ACTIVE (fraction of box diagonal)
BLUR_HULL_MARGIN_PCT=0.10

# ── Anonymization mode ───────────────────────────────────────────────────────
# How detected faces are anonymized: 'blur' (Gaussian-style box blur, default)
# or 'pixelate' (Google Street View style mosaic).
ANON_MODE=blur
# Mosaic block size in pixels when ANON_MODE=pixelate (2..128, default 12)
PIXELATE_CELL_PX=12

# ── FSM / ROI extraction (spec §4, §5) ───────────────────────────────────────
LEARNING_DAYS=30
ROI_EPS_PX=50
ROI_MIN_SAMPLES=15
ROI_RDP_EPSILON=5.0
ROI_AREA_MIN=0.10
ROI_AREA_MAX=0.90
ROI_MARGIN_PCT=0.05

# ── Retraining (spec §6) ─────────────────────────────────────────────────────
# HH:MM local time
CRON_RETRAIN_SCHEDULE=03:00
RETRAIN_MIN_ACCURACY=0.85
RETRAIN_HOLDOUT_FRACTION=0.10
RETRAIN_EPOCHS=5
RETRAIN_BATCH_SIZE=32

# ── Operator endpoints (spec §4) ─────────────────────────────────────────────
# If empty, operator endpoints are disabled (403)
OPERATOR_API_KEY=