# ── Server ────────────────────────────────────────────────────────────────────
BIND_ADDR=0.0.0.0:8080
# Max accepted upload body size in bytes for /anonymize (spec: min 3.5 GiB).
# /anonymize/batch has no body limit (archives are spooled to disk, and
# MAX_ARCHIVES_PER_BATCH / MAX_BATCH_TOTAL_BYTES bound the request instead).
BODY_LIMIT_BYTES=3758096384
# Deadline for the UPLOAD PHASE of a request, in seconds (default 3600,
# 0 = disabled). It covers how long a client may take to deliver the body
# (multipart header + archive transfer; /anonymize/batch shares one budget
# across all its archives) and answers 408 when exceeded. Processing is NOT
# counted, so a job that takes hours — a huge archive, slow CPU inference —
# still completes: the knob exists because the global single-job lock is taken
# BEFORE the upload is spooled, so without it one client that dribbles its body
# keeps every other client out (slowloris DoS). Raise it (or set 0) if clients
# upload over a slow link.
REQUEST_TIMEOUT_SECS=3600
# Per-image inference concurrency. When unset it is auto-detected:
# cores ≤ 4 → all cores; cores > 4 → cores − 2. Override only to tune.
#MAX_CONCURRENT_IMAGES=8
# JPEG re-encode quality for processed JPEG outputs (PNG outputs are lossless)
JPEG_QUALITY=95
# Output normalization for the STORE archives: 'keep' preserves each input's
# format (JPEG→JPEG, PNG→PNG), 'jpeg' re-encodes every frame as JPEG (.jpg),
# 'png' as lossless PNG (.png). The output names follow the forced format.
OUTPUT_FORMAT=keep
# Downscale the anonymized output so its larger side is ≤ this many px,
# applied after anonymization (0 = off, or ≥ 128). Shrinks storage when the
# original frames are 4K/UHD but the use-case only needs ~1080p. Camera
# geometry and masks are unaffected.
OUTPUT_MAX_SIDE=0

# ── Models (downloaded at runtime, spec §3) ──────────────────────────────────
# Public yolov8n-face ONNX (5 keypoints, output [1,15,8400]) used as a working
# default for testing. Override with your own export for production.
YOLO_MODEL_URL=https://github.com/lindevs/yolov8-face/releases/download/1.0.1/yolov8m-face-lindevs.onnx
# Optional: initial classifier (binary face/false-positive 2-class ONNX,
# input [1,3,224,224] ImageNet-normalized, softmax output [fp, face]). Until
# this is set (or the first nightly retrain swaps one in), ACTIVE cameras
# blur every in-ROI detection (fail-safe). The second check *filters* — i.e.
# leaves a YOLO detection unblurred — only when CLASSIFIER_ENFORCE=true (see
# the classifier knobs in the pipeline section). Check the live state —
# loaded, active_check_enabled, enforce, accuracy, last swap, inference
# counters — via the operator endpoint:
#   curl -H "X-Operator-Key: $KEY" http://localhost:8080/operator/classifier
CLASSIFIER_MODEL_URL=
MODEL_CACHE_DIR=/app/models/cache/
# Optional SHA-256 integrity checks (hex). Empty = skip verification. Pin them
# in production: with no hash the only integrity gate is a weak "looks like
# ONNX" check on the downloaded file.
MODEL_YOLO_SHA256=652f1ee6cd0291295de3d8fcaf9375ad62ef269055c0ada458bfdc4e7e6095da
MODEL_CLASSIFIER_SHA256=
# Model download policy (hardening). The download client follows at most this
# many redirects (0 = none: a 302 pointing away from the pinned URL is refused,
# which closes the "URL controlled → arbitrary ONNX" path).
MODEL_MAX_REDIRECTS=2
# Allow plain http:// for non-loopback model hosts (default false: https:// is
# required). http:// on 127.0.0.1/localhost/::1 is always allowed, so a local
# model server keeps working.
MODEL_ALLOW_HTTP=false
# Refuse to resolve a model that has no matching MODEL_*_SHA256 (default false,
# so the optional segmenter/COCO models can be used unhashed). Set true in
# production: a MITM-ed download without a hash would otherwise be parsed by
# ONNX Runtime.
MODEL_SHA_REQUIRED=false
# Head fallback: when the face detector finds no faces (e.g. pure-profile
# shots), run a COCO person detector and blur the upper fraction of each
# person box. Default off.
HEAD_FALLBACK_ENABLED=false
COCO_MODEL_URL=https://github.com/ultralytics/assets/releases/download/v8.4.0/yolov8n.onnx
MODEL_COCO_SHA256=
# Fraction of the person-box height treated as the head region (0.05..0.9).
HEAD_FALLBACK_FRACTION=0.30
# Optional ACTIVE face-mask segmenter: 'off' (default, geometric
# hull/ellipse masks) or 'mediapipe' (MediaPipe Selfie silhouette, dilated
# 25% ∪ box ellipse — see scripts/mask_preview.py for the approved A/B).
# The model is a small quantized export (~0.2 MB) cached under MODEL_CACHE_DIR.
MASK_SEGMENTER=off
SELFIE_SEGMENTER_MODEL_URL=https://huggingface.co/onnx-community/mediapipe_selfie_segmentation/resolve/main/onnx/model_quantized.onnx
MODEL_SELFIE_SHA256=
# Faces whose detection box is narrower than this many px are masked with the
# geometric hull/ellipse instead of the per-face selfie inference (0 = keep the
# segmenter on every face). For crowded scenes a value like 64 removes most of
# the per-face ONNX cost with ~no visible difference on tiny faces.
#SEGMENTER_MIN_BOX=64

# ── Storage ──────────────────────────────────────────────────────────────────
DATA_DIR=/app/data/
DATASET_FP_DIR=/app/dataset_falsi_positivi/
DATASET_SEED_REAL_FACES_DIR=/app/dataset_seed/real_faces/
MODELS_BACKUP_DIR=/app/models/backup/

# Retention of the anonymized outputs (<input>_elaborato.zip) accumulated in
# DATA_DIR. A background loop prunes them by age and/or total size. Set
# RETENTION_ENABLED=false (or both thresholds to 0) to disable entirely.
RETENTION_ENABLED=true
# Delete outputs older than this many days (0 = rule off)
RETENTION_MAX_DAYS=30
# When the total size of outputs exceeds this (GB), delete the oldest
# eligible ones first until back under the threshold (0 = rule off)
RETENTION_MAX_GB=20.0
# How often the cleanup pass runs (seconds)
RETENTION_INTERVAL_SECS=3600
# Outputs modified more recently than this are never deleted (seconds) —
# protects outputs mid-write or currently streaming back to a client
RETENTION_MIN_AGE_SECS=1800

# ── Resource limits (zip-bomb / DoS guards) ─────────────────────────────────
# Each value is a cap enforced while reading an archive; 0 disables that single
# check. Exceeding a cap aborts the whole job (400/413) because the archive is
# hostile — unlike a merely corrupt entry, which is skipped and reported
# per-entry as always. The stderr/HTTP path never buffers an upload in RAM
# (uploads are spooled to DATA_DIR), so these caps bound decompression and
# per-image allocation, not the upload itself.
# Max entries in a single archive.
MAX_ENTRIES_PER_ARCHIVE=100000
# Max bytes of one decompressed entry (~200 MiB).
MAX_ENTRY_BYTES=209715200
# Max total decompressed bytes per archive (8 GiB), across all entries.
MAX_TOTAL_UNCOMPRESSED_BYTES=8589934592
# Max uncompressed/compressed ratio per entry. This is a spike detector, not
# the primary bound (the byte caps above already limit allocation); a 405 KB
# text entry legitimately deflates ~1900x, so do not lower it without testing
# your own workload with scripts/bench_classifier.py-style checks.
MAX_COMPRESSION_RATIO=500
# Image decode bounds passed to the image decoder (px and total allocation
# bytes): a 20000x20000 RGBA frame would otherwise allocate ~1.5 GiB.
MAX_IMAGE_WIDTH=20000
MAX_IMAGE_HEIGHT=20000
MAX_IMAGE_ALLOC_BYTES=536870912
# Max size of a single uploaded archive (bytes). Independent of
# BODY_LIMIT_BYTES, which is the second ceiling on /anonymize. It also bounds
# the download of an input object from S3.
MAX_ARCHIVE_BYTES=3758096384
# /anonymize/batch (no body limit): max archives per request, and max total
# bytes spooled for the whole request on top of the per-archive cap.
MAX_ARCHIVES_PER_BATCH=64
MAX_BATCH_TOTAL_BYTES=10737418240

# ── Pipeline thresholds ──────────────────────────────────────────────────────
# The keys in this section (plus the ones marked "(hot-tunable)" further below:
# ANON_MODE, PIXELATE_CELL_PX, MASK_FEATHER_SIGMA, BLUR_ELLIPSE_MARGIN,
# CLASSIFIER_CONFIRM_THRESHOLD, CLASSIFIER_ENFORCE, HEAD_FALLBACK_FRACTION,
# JPEG_QUALITY, OUTPUT_MAX_SIDE) are HOT-TUNABLE: the operator UI/API at
# /operator/settings changes them LIVE on the running service (no restart) and
# persists the patch to DATA_DIR/runtime_config.json (re-applied on the next
# start). The .env lines are the startup defaults only; the authoritative list
# and schema is what GET /operator/settings.json returns (16 fields).
# Detector confidence for LEARNING cameras (higher → cleaner retraining set).
YOLO_CONF_THRESHOLD=0.10
# Detector confidence for ACTIVE cameras (lower → fewer unblurred faces;
# falls back to YOLO_CONF_THRESHOLD when unset).
YOLO_CONF_THRESHOLD_ACTIVE=0.05
YOLO_NMS_IOU=0.45
# Detector input side in px (multiple of 32, 256..=1280, default 640). Lower
# values (e.g. 512) speed up large/UHD inputs at a small cost in small-face
# recall.
YOLO_INPUT_SIZE=640
# Detections with confidence in [threshold, FP_CROP_CONF_MAX) are saved as
# false-positive candidates for retraining
FP_CROP_CONF_MAX=0.50
# (hot-tunable) CLASSIFIER_ENFORCE (default true). When false the binary
# classifier is still loaded — for nightly retraining and A/B validation — but
# the ACTIVE branch blurs every YOLO detection: classification can never
# *remove* a blur. GET /operator/classifier reports the live state
# (active_check_enabled=false while a model is loaded ⇒ the check is bypassed).
CLASSIFIER_ENFORCE=true
# (hot-tunable) CLASSIFIER_CONFIRM_THRESHOLD (0.01..1.0, default 0.5). A
# detection is blurred only if the classifier's p_face is at least this value,
# and only when CLASSIFIER_ENFORCE=true. Lower = higher recall, at the cost of
# re-blurring dubious regions.
CLASSIFIER_CONFIRM_THRESHOLD=0.5
# Full-image blur sigma for the INITIAL fallback state
INITIAL_BLUR_SIGMA=20.0
# Extra dilation of the keypoint convex hull in ACTIVE (fraction of box diagonal)
BLUR_HULL_MARGIN_PCT=0.10
# (hot-tunable) Ellipse margin used when a detection exports no keypoints (and
# for the head-fallback ellipse): widens the masked cover around the box.
BLUR_ELLIPSE_MARGIN=0.05
# (hot-tunable) Softening sigma for the ACTIVE mask edge (0 = auto: reuse the
# blur sigma). A small fixed value (e.g. 8) keeps face silhouettes crisp on
# large close-ups, where the blur sigma can reach ~50 px.
MASK_FEATHER_SIGMA=0.0

# ── Anonymization mode ───────────────────────────────────────────────────────
# (hot-tunable) How detected faces are anonymized: 'blur' (Gaussian-style box
# blur, default) or 'pixelate' (Google Street View style mosaic).
ANON_MODE=blur
# (hot-tunable) Mosaic block size in pixels when ANON_MODE=pixelate (2..128)
PIXELATE_CELL_PX=12

# ── FSM / ROI extraction (spec §4, §5) ───────────────────────────────────────
LEARNING_DAYS=30
ROI_EPS_PX=50
ROI_MIN_SAMPLES=15
ROI_RDP_EPSILON=5.0
ROI_AREA_MIN=0.10
ROI_AREA_MAX=0.90
ROI_MARGIN_PCT=0.05
# Dynamic ROI for ACTIVE cameras: every nightly pass re-extracts the polygon
# from the anonymized detections of the last ROI_REEXTRACT_WINDOW_DAYS and
# swaps it only if it differs from the deployed one by more than
# ROI_REEXTRACT_MIN_IOU (stability guard — a frame-geometry change is always
# adopted). Set ROI_REEXTRACT_ENABLED=false to freeze ROI exactly at ACTIVE.
ROI_REEXTRACT_ENABLED=true
ROI_REEXTRACT_WINDOW_DAYS=7
ROI_REEXTRACT_MIN_IOU=0.60

# ── Retraining (spec §6) ─────────────────────────────────────────────────────
# HH:MM local time
CRON_RETRAIN_SCHEDULE=03:00
RETRAIN_MIN_ACCURACY=0.85
# A/B regression tolerance: the candidate is swapped only if its Rust-validated
# accuracy is ≥ (current − eps) on the same deterministic holdout, besides the
# absolute RETRAIN_MIN_ACCURACY floor. 0 = the candidate must at least match
# the deployed model; on success the consumed FP crops are cleared and the live
# model+accuracy are persisted in DATA_DIR/classifier_state.json.
RETRAIN_REGRESSION_EPS=0.0
RETRAIN_HOLDOUT_FRACTION=0.10
RETRAIN_EPOCHS=5
RETRAIN_BATCH_SIZE=32

# ── Inference backend (GPU) ──────────────────────────────────────────────────
# ONNX Runtime execution provider: 'cpu' (default), 'cuda', 'tensorrt',
# 'directml' (Windows). The GPU choices require the binary to be COMPILED with
# the matching cargo feature (Dockerfile.gpu builds with --features cuda).
# Selecting a GPU without the compiled support, or without the CUDA/cuDNN
# runtime present, fails fast at startup (never silently runs on CPU).
ORT_EXECUTION_PROVIDER=cpu
# GPU index to use (CUDA device handles are unsigned; negatives clamp to 0).
ORT_CUDA_DEVICE_ID=0
# Optional cap of the device-memory arena / TensorRT workspace (bytes),
# e.g. 8589934592 = 8 GiB. Prevents OOM when several pool sessions share the
# device. Empty = let ONNX Runtime pick.
ORT_CUDA_MEMORY_LIMIT_BYTES=
# TensorFloat-32 on Ampere+ GPUs (CUDA EP; faster MatMul/Conv, off by default).
ORT_ENABLE_TF32=false
# Reduced-precision fp16 — TensorRT EP only (the CUDA EP has no fp16 toggle).
ORT_ENABLE_FP16=false

# ── S3 storage backend (spec §8 "Scenario S3", feature `s3`) ────────────────
# Asynchronous ingestion from an S3-compatible bucket (MinIO / AWS / Digital
# Ocean Spaces...). Requires the binary COMPILED with the `s3` cargo feature
# (Docker build arg FEATURES=retraining,s3 — see docker-compose.minio.yml).
# Disabled by default: /anonymize/s3, /status/:job_id and /operator/s3/sweep
# are not registered and no AWS SDK code runs.
S3_ENABLED=false
# Endpoint of the S3-compatible store. Empty = real AWS (virtual-hosted
# addressing). Set for MinIO, e.g. http://minio:9000.
S3_ENDPOINT=
# Force path-style bucket addressing (default: true when S3_ENDPOINT is set,
# otherwise false). Explicit override:
#S3_FORCE_PATH_STYLE=true
# Credentials come from the standard AWS_ env chain:
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION
S3_BUCKET_INPUT=anonimizzazione-input
S3_BUCKET_OUTPUT=anonimizzazione-output
S3_BUCKET_LOGS=anonimizzazione-logs
# Max concurrent S3 jobs. Every job still respects MAX_CONCURRENT_IMAGES for
# its per-image work (bounded semaphore, not one task = one parallel job).
S3_MAX_CONCURRENT_JOBS=2
# Require the operator key (X-Operator-Key) on /anonymize/s3 and
# /status/:job_id (default true). Without it, anyone reaching the port could
# process, overwrite or delete arbitrary bucket keys; disable it only behind a
# trusted network and with OPERATOR_API_KEY unset.
S3_INGEST_AUTH_REQUIRED=true
# Honour the `delete_input_on_success` flag carried by an SQS/RabbitMQ message
# (default false). A queue message is producer-controlled data, so leave this
# off unless your producers are fully trusted: with true, a forged message
# deletes input objects from the bucket.
S3_TRUST_MESSAGE_DELETE=false
# Completion webhook allowlist: comma-separated "host[:port]". Empty = the
# webhook is REJECTED at submit time (anti-SSRF): the job still runs and the
# completion channels are the audit log object + /status/:job_id polling.
# In addition to the allowlist, redirects are never followed and a host that
# resolves to a private/link-local address (e.g. 169.254.169.254) is refused.
#S3_WEBHOOK_ALLOWED_HOSTS=notifiche.internal:8443, altro.example

# ── SQS async job intake (feature `queue`) ──────────────────────────────────
# Long-polls a standard SQS queue for {input_key, output_key?, callback_url?}
# messages and drives each through the S3 worker (same pipeline, audit log,
# webhook). Requires the binary compiled with the `queue` cargo feature
# (implies `s3`) and S3_ENABLED=true. Credentials from the standard AWS chain.
SQS_ENABLED=false
# Queue URL to poll (required when enabled), e.g.
# https://sqs.eu-central-1.amazonaws.com/123456789012/anonimizzazione-jobs
SQS_QUEUE_URL=
# Optional region override (default: from the AWS_* chain)
#SQS_REGION=eu-central-1
# Max messages per poll (1..=10) and long-poll wait seconds (0..=20)
SQS_MAX_MESSAGES=10
SQS_WAIT_SECONDS=20
# Visibility timeout for in-flight messages (s): a job that crashes is
# redelivered after this window
SQS_VISIBILITY_TIMEOUT_SECONDS=900
# Sleep between empty polls (s); on poll errors the wait grows
# exponentially (base * 2^n) up to SQS_MAX_BACKOFF_SECS, then the client is
# rebuilt — the consumer never exits on transient throttling/5xx errors.
SQS_POLL_INTERVAL_SECS=5
SQS_MAX_BACKOFF_SECS=60
# After this many receive attempts a message is sent to the DLQ. The DLQ is
# auto-created ({queue}-dlq) with a redrive policy using this value as
# maxReceiveCount — poison messages never loop forever.
SQS_MAX_RECEIVE_ATTEMPTS=5

# ── RabbitMQ async job intake (feature `rabbitmq`) ─────────────────────────
# Manual-ack AMQP consumer: {input_key, output_key?, callback_url?} messages,
# ack on success, retry with exponential backoff, DLQ after max retries.
# Requires the `rabbitmq` cargo feature (implies `s3`) and S3_ENABLED=true.
RABBITMQ_ENABLED=false
# Credentials are redacted in the logs (amqp://***@host).
RABBITMQ_URL=amqp://127.0.0.1:5672
RABBITMQ_QUEUE=anonimizzazione-jobs
# Dead-letter queue (durable); poison messages land here after max retries.
# A message whose `message_id` is not a safe id ([A-Za-z0-9._-], no ".." and
# ≤ 128 chars) goes straight to the DLQ: it becomes a filesystem path and an
# audit-log key, so a crafted id must never be accepted.
RABBITMQ_DLQ=anonimizzazione-jobs-dlq
# Max unacked deliveries held by this consumer (= concurrent jobs)
RABBITMQ_PREFETCH=4
# Max delivery attempts before a message is sent to the DLQ
RABBITMQ_MAX_RETRIES=3
# Exponential backoff: base seconds * 2^attempts, capped at max
RABBITMQ_RETRY_BACKOFF_SECS=5
RABBITMQ_MAX_BACKOFF_SECS=300

# ── Operator endpoints (spec §4) ─────────────────────────────────────────────
# REQUIRED by the shipped docker compose files (no default: a well-known key
# would hand every operator route to anyone who reaches the port, and the
# container now refuses to start until this is set). Empty = operator endpoints
# are disabled; the route answers 403 with a single generic message, so a caller
# cannot tell whether a key is configured. The key is compared in constant time
# and failed attempts are logged. There is no TLS in-process: terminate HTTPS at
# a reverse proxy (or keep BIND_ADDR on loopback / behind the firewall).
OPERATOR_API_KEY=
