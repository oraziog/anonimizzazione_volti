# ── Builder ─────────────────────────────────────────────────────────────────
# Same as the CPU Dockerfile, but the binary is compiled with the `cuda`
# feature so ort's `download-binaries` fetches the GPU-enabled ONNX Runtime
# (CUDA 13 + cuDNN 9, x86_64-linux) instead of the CPU build. The CUDA toolkit
# is NOT needed in this stage: ort uses the prebuilt shared libraries.
FROM rust:1.88-bookworm AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-dev python3-venv pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .

ENV PYO3_PYTHON=python3
RUN cargo build --release --features retraining,cuda

# ── Runtime ─────────────────────────────────────────────────────────────────
# Adjust this tag to the CUDA/cuDNN combination your host driver supports and
# to what the ort-sys prebuilt binaries require (libcudart/libcublas/libnvrtc
# + libcudnn*.so.9). Verify the loaded libraries inside a running container
# with: ldd /app/anonimizzazione_volti; nvidia-smi.
FROM nvidia/cuda:13.1.1-cudnn9-runtime-ubuntu24.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv libgomp1 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# PyTorch CPU wheels for the nightly retraining (python/retrain.py). The ONNX
# inference itself runs on the GPU through the Rust binary; PyTorch only
# fine-tunes and re-exports, so the CPU build is enough (and smaller).
RUN pip3 install --break-system-packages --no-cache-dir \
        torch torchvision --index-url https://download.pytorch.org/whl/cpu

WORKDIR /app

# All shared libraries that ort's `copy-dylibs` placed in target/release:
# the ONNX Runtime itself plus the CUDA provider libs (`.so*` covers
# libonnxruntime.so, libonnxruntime_providers_cuda.so, providers_shared…).
COPY --from=builder /app/target/release/anonimizzazione_volti /usr/local/bin/anonimizzazione_volti
COPY --from=builder /app/target/release/*.so* /usr/local/lib/
COPY --from=builder /app/python/retrain.py /app/python/retrain.py

ENV LD_LIBRARY_PATH=/usr/local/lib \
    RETRAIN_SCRIPT_PATH=/app/python/retrain.py \
    RUST_LOG=info \
    ORT_EXECUTION_PROVIDER=cuda

# Persistent volumes (models survive restarts; the database and datasets too).
VOLUME ["/app/models", "/app/data", "/app/dataset_falsi_positivi", "/app/dataset_seed"]

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["anonimizzazione_volti"]