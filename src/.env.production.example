# ── Template di produzione (valori misurati / raccomandati) ─────────────────
# Copiate in `.env` e adattate a reti, bucket e credenziali reali. Ogni valore
# è un env var letta all'avvio; nessuna UI. `docker compose up --build` con
# env_file: .env (il binario locale NON legge .env da solo).
#
# Differenze rispetto a .env.example: dati STORE ridotti (JPEG_QUALITY=85,
# OUTPUT_MAX_SIDE facoltativo), MASK_SEGMENTER=mediapipe, SEGMENTER_MIN_BOX=64,
# BIND_ADDR bound a una sola interfaccia, OPERATOR_API_KEY obbligatorio,
# retention attiva.

# ── Server ───────────────────────────────────────────────────────────────────
# Expose SOLO l'interfaccia del reverse proxy (mai 0.0.0.0 se pubblico).
BIND_ADDR=0.0.0.0:8080
BODY_LIMIT_BYTES=3758096384
# Concorrenza: lasciarla auto (cores ≤ 4 → cores, cores > 4 → cores − 2).
#MAX_CONCURRENT_IMAGES=8
# STORE: qualità 85 = ~25–30% di output in meno vs 95, nessuna differenza
# percepibile su footage anonimizzato.
JPEG_QUALITY=85
# Formato uniforme dell'output: keep | jpeg | png.
OUTPUT_FORMAT=keep
# Downscale post-anonimizzazione (max lato in px; 0 = off, ≥ 128). Es. UHD→1080.
OUTPUT_MAX_SIDE=0

# ── Modelli (spec §3) ────────────────────────────────────────────────────────
YOLO_MODEL_URL=https://github.com/yakhyo/yolov8-face-onnx-inference/releases/download/weights/yolov8n-face.onnx
# In produzione: sostituire o impostare il proprio classificatore già pronto.
CLASSIFIER_MODEL_URL=
MODEL_CACHE_DIR=/app/models/cache/
MODEL_YOLO_SHA256=33f3951af7fc0c4d9b321b29cdcd8c9a59d0a29a8d4bdc01fcb5507d5c714809
MODEL_CLASSIFIER_SHA256=
RETINAFACE_MODEL_URL=https://github.com/yakhyo/retinaface-pytorch/releases/download/v0.0.1/retinaface_mv1_0.25.onnx
MODEL_RETINAFACE_SHA256=
# ACTIVE: silhouette MediaPipe (migliore aderenza al contorno viso) con
# shortcut geometrico sui volti piccoli per il budget di calcolo.
MASK_SEGMENTER=mediapipe
SELFIE_SEGMENTER_MODEL_URL=https://huggingface.co/onnx-community/mediapipe_selfie_segmentation/resolve/main/onnx/model_quantized.onnx
MODEL_SELFIE_SHA256=
# Volti con box < 64 px → hull/ellisse geometrica (no inferenza ONNX per-faccia).
SEGMENTER_MIN_BOX=64

# ── Storage ──────────────────────────────────────────────────────────────────
DATA_DIR=/app/data/
DATASET_FP_DIR=/app/dataset_falsi_positivi/
DATASET_SEED_REAL_FACES_DIR=/app/dataset_seed/real_faces/
MODELS_BACKUP_DIR=/app/models/backup/
# Retention degli output. TENETE ATTIVA (default) per non riempire il disco.
RETENTION_ENABLED=true
RETENTION_MAX_DAYS=30
RETENTION_MAX_GB=20.0
RETENTION_INTERVAL_SECS=3600
RETENTION_MIN_AGE_SECS=1800

# ── Pipeline ─────────────────────────────────────────────────────────────────
YOLO_CONF_THRESHOLD=0.10
YOLO_CONF_THRESHOLD_ACTIVE=0.05
YOLO_NMS_IOU=0.45
DETECTOR_MODE=yolo
YOLO_INPUT_SIZE=640
RETINAFACE_INPUT_SIZE=640
FP_CROP_CONF_MAX=0.50
INITIAL_BLUR_SIGMA=20.0
BLUR_HULL_MARGIN_PCT=0.10
# ANSI_MODE come da normativa interna: blur | pixelate.
ANON_MODE=blur
PIXELATE_CELL_PX=12

# ── FSM / ROI ───────────────────────────────────────────────────────────────
LEARNING_DAYS=30
ROI_EPS_PX=50
ROI_MIN_SAMPLES=15
ROI_RDP_EPSILON=5.0
ROI_AREA_MIN=0.10
# Per angoli molto ampi in cui la strada riempie il frame: 1.0 (oppure usare
# POST /operator/cameras/:id/roi {"type":"full"}).
ROI_AREA_MAX=0.90
ROI_MARGIN_PCT=0.05
# Dynamic ROI ACTIVE: ri-estrazione notturna dalla finestra recente, swap solo
# se diversa oltre la guardia di stabilità (IoU). false → ROI congelata.
ROI_REEXTRACT_ENABLED=true
ROI_REEXTRACT_WINDOW_DAYS=7
ROI_REEXTRACT_MIN_IOU=0.60

# ── Retraining (spec §6) ─────────────────────────────────────────────────────
CRON_RETRAIN_SCHEDULE=03:00
RETRAIN_MIN_ACCURACY=0.85
# A/B: swap solo se candidate ≥ current − eps sullo stesso holdout.
RETRAIN_REGRESSION_EPS=0.0
RETRAIN_HOLDOUT_FRACTION=0.10
RETRAIN_EPOCHS=5
RETRAIN_BATCH_SIZE=32

# ── Operatore ────────────────────────────────────────────────────────────────
# OBBLIGATORIO in produzione: senza chiave tutti gli endpoint operator sono
# 403. Usate un segreto lungo (es. `openssl rand -hex 32`).
OPERATOR_API_KEY=

# ── Backend di inferenza (GPU) ───────────────────────────────────────────────
# Per GPU compilare con Dockerfile.gpu (feature cuda inclusa); con il build CPU
# questi valori sono ignorati: il servizio parte sempre con ORT_EXECUTION_PROVIDER=cpu.
# 'cuda' richiede a runtime CUDA 13 + cuDNN 9 (immagine base nvidia/cuda con
# tag da allineare al driver host); il provider GPU è registrato davanti alla
# CPU, ma se non è utilizzabile l'avvio FALLISCE (mai fallback silenzioso).
ORT_EXECUTION_PROVIDER=cpu
ORT_CUDA_DEVICE_ID=0
# Arena GPU per sessione. Con il pool di sessioni (MAX_CONCURRENT_IMAGES)
# tenete il cap così il device non va in OOM: es. 8 GiB.
#ORT_CUDA_MEMORY_LIMIT_BYTES=8589934592
# TF32 (Ampere+): consigliato true con GPU NVIDIA recenti.
ORT_ENABLE_TF32=true
# fp16 solo per TensorRT (la CUDA EP non ha toggle fp16).
ORT_ENABLE_FP16=false

# ── Backend S3 (spec §8, feature `s3`) ──────────────────────────────────────
# Attivo SOLO se il binario è compilato con `cargo build --features s3`
# (Docker: build arg FEATURES=retraining,s3). Con S3_ENABLED=false le route
# /anonymize/s3, /status/:job_id e /operator/s3/sweep non esistono.
# Credenziali standard AWS_: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_REGION (o profilo file ~/.aws). Endpoint vuoto = AWS reale.
S3_ENABLED=false
S3_ENDPOINT=
#S3_FORCE_PATH_STYLE=true   # consigliato per MinIO (default true con endpoint)
S3_BUCKET_INPUT=anonimizzazione-input
S3_BUCKET_OUTPUT=anonimizzazione-output
S3_BUCKET_LOGS=anonimizzazione-logs
# Concorrenza job: bilanciate rispetto a quanto l'host sopporta; ogni job ha
# comunque il suo limite per-immagine (MAX_CONCURRENT_IMAGES).
S3_MAX_CONCURRENT_JOBS=2
# Webhook di completamento: OBBLIGATORIO l'allowlist (anti-SSRF). Vuoto =
# webhook rifiutato alla submit; usare /status/:job_id o l'audit log.
#S3_WEBHOOK_ALLOWED_HOSTS=notifiche.intranet:8443